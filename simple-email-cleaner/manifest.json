{
  "manifest_version": 3,
  "name": "Simple Email Cleaner",
  "version": "1.0.0",
  "description": "Clean up your inbox by detecting and removing spam/promotional emails with one click",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "storage"
  ],
  "background": {
    "service_worker": "src/background/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["src/content/gmail.js"],
      "css": []
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Simple Email Cleaner"
  },
  "host_permissions": [
    "https://mail.google.com/*"
  ]
}